	"pages": [
		{
			"$type": "Page",
			"id": 1,
			"title": "Home",
			"hero": {
				"$type": "Hero",
				"type": "HIGH_IMPACT",
				"richText": "<h1>The vanilla foundation to build the modern web</h1><p>Janilla leverages standard technologies and principles to let you develop overengineering-free equivalent of web applications relying on heavy frameworks.</p>",
				"links": [
					{
						"$type": "LinkImpl",
						"type": "CUSTOM",
						"uri": "/posts",
						"text": "All posts",
						"appearance": "DEFAULT"
					},
					{
						"$type": "LinkImpl",
						"type": "CUSTOM",
						"uri": "/contact",
						"text": "Contact",
						"appearance": "OUTLINE"
					}
				],
				"media": 4
			},
			"layout": [
				{
					"$type": "Content",
					"columns": [
						{
							"$type": "Column",
							"size": "FULL",
							"richText": "<h2>Vanilla Packages</h2><p>Just plain standard source code, organized into a flat hierarchy of small files.</p>"
						},
						{
							"$type": "Column",
							"size": "ONE_THIRD",
							"richText": "<h3>CMS</h3><p>Models content as documents and files. Provides API endpoints to read and write content. Generates the Admin Panel. Supports versions and drafts.<br />(Source: <a href=\"#\">backend</a>, <a href=\"#\">frontend</a>)</p>"
						},
						{
							"$type": "Column",
							"size": "ONE_THIRD",
							"richText": "<h3>Frontend</h3><p>Simplifies web component development by replacing manual DOM manipulation with declarative HTML template interpolation.<br />(<a href=\"#\">Source</a>)</p>"
						},
						{
							"$type": "Column",
							"size": "ONE_THIRD",
							"richText": "<h3>HTTP</h3><p>Provides HTTP/1.1 and HTTP/2 client and server.<br />(<a href=\"#\">Source</a>)</p>"
						},
						{
							"$type": "Column",
							"size": "ONE_THIRD",
							"richText": "<h3>IoC</h3><p>Provides a factory with Dependency Injection capability.<br />(<a href=\"#\">Source</a>)</p>"
						},
						{
							"$type": "Column",
							"size": "ONE_THIRD",
							"richText": "<h3>Java</h3><p>Allows dynamic inspection and manipulation of arbitrary objects. Handles advanced type conversion. Provides other utilities such as scanning Java classpath and modules.<br />(<a href=\"#\">Source</a>)</p>"
						},
						{
							"$type": "Column",
							"size": "ONE_THIRD",
							"richText": "<h3>JSON</h3><p>Formats Java objects as JSON strings. Parses JSON input. Also provides utilities for JWT.<br />(<a href=\"#\">Source</a>)</p>"
						},
						{
							"$type": "Column",
							"size": "ONE_THIRD",
							"richText": "<h3>Net</h3><p>Extends Java NIO to support SSL transfers. Provides a base secure server.<br />(<a href=\"#\">Source</a>)</p>"
						},
						{
							"$type": "Column",
							"size": "ONE_THIRD",
							"richText": "<h3>Persistence</h3><p>Models data as entities. Defines annotations for stores and indexes. Provides a base for CRUD operations.<br />(<a href=\"#\">Source</a>)</p>"
						},
						{
							"$type": "Column",
							"size": "ONE_THIRD",
							"richText": "<h3>SMTP</h3><p>Sends emails.<br />(<a href=\"#\">Source</a>)</p>"
						},
						{
							"$type": "Column",
							"size": "ONE_THIRD",
							"richText": "<h3>SQLite</h3><p>Reads and writes data into tables and indexes stored as B-Trees in a file, using SQLite format.<br />(<a href=\"#\">Source</a>)</p>"
						},
						{
							"$type": "Column",
							"size": "ONE_THIRD",
							"richText": "<h3>Web</h3><p>Serves static files or dynamically invokes Java methods in HTTP exchanges. Handles request data binding and result rendering in response.<br />(<a href=\"#\">Source</a>)</p>"
						}
					]
				},
				{
					"$type": "Archive",
					"introContent": "<h3>Recent posts</h3>"
				}
			],
			"meta": {
				"$type": "Meta",
				"title": "Janilla Website Template",
				"description": "An open-source website built with Janilla.",
				"image": 4
			},
			"slug": "home",
			"documentStatus": {
